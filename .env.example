# Copy to .env (never commit .env) and fill in. Read by docker-compose.yml.
# Put values containing special characters in single quotes: SMTP_PASSWORD='p@ss$word'

# Public domain, served by nginx on the VPS (deploy/nginx/melliniumimmobiliere.tn.conf).
SITE_DOMAIN=melliniumimmobiliere.tn
# Port the site listens on, on 127.0.0.1 only (nginx proxies to it).
WEB_PORT=3000

# PostgreSQL. Use a long random password made of letters and digits only (it goes into a URL).
# Generate one with: openssl rand -hex 24
POSTGRES_USER=mellinium
POSTGRES_PASSWORD=

# Shared secret with the CRM: same value as MELLINIUM_API_KEY in the CRM back-end's .env.
# Generate one with: openssl rand -hex 32
CRM_API_KEY=

# Contact form e-mails (OVH Zimbra). SMTP_USER only authenticates and sends;
# every message is delivered to MAIL_TO, with the visitor as Reply-To.
SMTP_HOST=smtp.mail.ovh.net
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=smpt@melliniumimmobiliere.tn
SMTP_PASSWORD=
MAIL_TO=contact@melliniumimmobiliere.tn
MAIL_FROM_NAME=Site Mellinium Immobilière

# Outside Docker (npm run dev against a local Postgres), set these instead:
# DATABASE_URL=postgres://mellinium:password@localhost:5432/mellinium
# MEDIA_DIR=./.data/media
# SITE_URL=http://localhost:3000
